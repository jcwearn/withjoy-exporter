# Copy this file to .env and fill in your values.
# .env is gitignored so credentials stay local.

# Required
WITHJOY_USERNAME=your-collaborator-email@example.com
WITHJOY_PASSWORD=your-password
WITHJOY_GUEST_LIST_URL=https://withjoy.com/<event-slug>/edit/guests
SHEET_ID=your-google-spreadsheet-id

# Optional (defaults shown)
# GOOGLE_APPLICATION_CREDENTIALS=/secrets/google-service-account.json
# LATEST_TAB_NAME=latest
# TIMEZONE=America/New_York
# HISTORY_KEEP_DAYS=5
# DEBUG=1
#
# EXPORT_COLUMNS pins the sheet's columns so a WithJoy schema change can't shift
# them. Unset (the default) exports every column WithJoy returns. When set, only
# these columns are written, in this order; a listed column missing from the
# export becomes an empty column, and any `<tag> (tag)` column not listed here is
# appended at the end. Separate with commas (or newlines, for a k8s ConfigMap).
# EXPORT_COLUMNS=first name,last name,mailing address,phone number,email,envelope name,address 1,address 2,city,state,postal code,country,tags,party,pellikuthuru,sangeet,muhurtham,dietary restrictions,reception,optional trip,golkonda guest covered,golkonda guest own,admin (tag),anupama (tag),Anupama MISC (tag),Batch 1 (tag),Batch 2 (tag),Batch 3 (tag),Batch 4 (tag),Emory (tag),hotel-golkonda-covered (tag),hotel-golkonda-own (tag),Indian community (tag),jackson (tag),McKinsey (tag),muhurtam (tag),Northwood (tag),not-coming (tag),optional-trip (tag),pellikuthuru (tag),plus-one (tag),plus-three (tag),plus-two (tag),reception (tag),sangeet (tag),USC (tag),Venkat (tag),Vidya (tag)

# Web trigger UI (web.py, k8s-only) uses NAMESPACE, CRONJOB_NAME, PORT and the
# GitHub App credentials below — set those in the k8s Deployment, not here.
# Without the App credentials the page still works; the schedule-sync buttons
# are disabled.
#
# GITHUB_APP_ID=123456
# GITHUB_APP_INSTALLATION_ID=87654321
# GITHUB_APP_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----...
# GITHUB_REPO=jcwearn/anupamaandjackson
# GITHUB_WORKFLOW_FILE=refresh-schedule-index.yml
# GITHUB_REF=main
