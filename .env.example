# Copy this file to .env and fill in your values.
# .env is gitignored so credentials stay local.

# Required
WITHJOY_USERNAME=your-collaborator-email@example.com
WITHJOY_PASSWORD=your-password
WITHJOY_GUEST_LIST_URL=https://withjoy.com/<event-slug>/edit/guests
SHEET_ID=your-google-spreadsheet-id

# Optional (defaults shown)
# GOOGLE_APPLICATION_CREDENTIALS=/secrets/google-service-account.json
# LATEST_TAB_NAME=latest
# TIMEZONE=America/New_York
# HISTORY_KEEP_DAYS=5
# DEBUG=1

# Web trigger UI (web.py, k8s-only) uses NAMESPACE, CRONJOB_NAME, PORT and the
# GitHub App credentials below — set those in the k8s Deployment, not here.
# Without the App credentials the page still works; the schedule-sync buttons
# are disabled.
#
# GITHUB_APP_ID=123456
# GITHUB_APP_INSTALLATION_ID=87654321
# GITHUB_APP_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----...
# GITHUB_REPO=jcwearn/anupamaandjackson
# GITHUB_WORKFLOW_FILE=refresh-schedule-index.yml
# GITHUB_REF=main
